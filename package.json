{
  "name": "sample-pg-template",
  "version": "1.0.0",
  "description": "A clean, reusable PostgreSQL backend template using Express 5 + TypeScript + Sequelize",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc --p tsconfig.json",
    "start": "node dist",
    "prodstart": "NODE_ENV=production && yarn start",
    "type-check": "tsc --noEmit",
    "eslint": "eslint \"src/*/*.ts\"",
    "format": "prettier --write .",
    "fix-eslint": "eslint 'src/*/*.ts' --fix",
    "test": "mocha --require ts-node/register test/*/*.spec.ts",
    
    "test:coverage": "nyc --reporter=text --reporter=html npm test",
    "db:migrate:up": "sequelize-cli db:migrate",
    "db:migrate:down": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "compression": "^1.7.4",
    "continuation-local-storage": "^3.2.1",
    "date-fns": "^3.6.0",
    "dotenv": "^18.0.3",
    "express": "^5.1.0",
    "fastest-validator": "^1.18.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "log4js": "^6.9.1",
    "nanoid": "^3.3.7",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "redis": "^5.12.1",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/continuation-local-storage": "^3.2.4",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-sonarjs": "^0.25.1",
    "husky": "^9.0.11",
    "mocha": "^11.8.0",
    "nodemon": "^3.1.4",
    "nyc": "^18.0.0",
    "prettier": "^3.3.3",
    "sequelize-cli": "^6.6.2",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
